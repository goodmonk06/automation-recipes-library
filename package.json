{
  "name": "automation-recipes-library",
  "version": "0.1.0",
  "description": "YAML-based automation recipe library for service integrations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "recipes": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/api/httpServer.ts",
    "dev:build": "tsc --watch",
    "build": "tsc",
    "start": "node dist/api/httpServer.js",
    "start:prod": "NODE_ENV=production node dist/api/httpServer.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "validate": "node dist/cli.js validate",
    "recipes:list": "node dist/cli.js list",
    "recipes:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "automation",
    "recipes",
    "yaml",
    "workflow"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.3.4",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
